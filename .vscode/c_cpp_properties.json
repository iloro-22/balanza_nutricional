{
    "configurations": [
        {
            "name": "EDU-CIAA ARM",
            "includePath": [
                "${workspaceFolder}/inc",
                "${workspaceFolder}/../../libs/freertos/include",
                "${workspaceFolder}/../../libs/freertos/include/private",
                "${workspaceFolder}/../../libs/freertos/source/portable/ARM_CM4F",
                "${workspaceFolder}/../../libs/cmsis_core/inc",
                "${workspaceFolder}/../../libs/lpc_open/boards/edu_ciaa_nxp/inc",
                "${workspaceFolder}/../../libs/lpc_open/boards/inc",
                "${workspaceFolder}/../../libs/lpc_open/lpc_chip_43xx/inc",
                "${workspaceFolder}/../../libs/lpc_open/lpc_chip_43xx/usbd_rom",
                "${workspaceFolder}/../../libs/sapi/sapi_v0.6.2/**"
            ],
            "defines": [
                "__USE_LPCOPEN",
                "CHIP_LPC43XX",
                "ARM_MATH_CM4",
                "__USE_NEWLIB",
                "CORE_M4",
                "__FPU_PRESENT=1U",
                "USE_SAPI",
                "BOARD=edu_ciaa_nxp"
            ],
            "compilerPath": "/usr/bin/arm-none-eabi-gcc",
            "compilerArgs": [
                "-mcpu=cortex-m4",
                "-mthumb",
                "-mfloat-abi=hard",
                "-mfpu=fpv4-sp-d16"
            ],
            "cStandard": "c99",
            "cppStandard": "c++11",
            "intelliSenseMode": "gcc-arm"
        }
    ],
    "version": 4
}